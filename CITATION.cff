  - family-names: Fengler
    given-names: Alexander
  - family-names: Radev
    given-names: Stefan T.
  - family-names: Huang
    given-names: Jerry M.
  - family-names: Muia
    given-names: Francesco
repository-code: "https://github.com/AlexanderFengler/Bayesify"
license: MIT
keywords:
  - bayesian-workflow
  - bayesian-statistics
  - reproducibility
  - research-assessment
  - computational-cognitive-science
