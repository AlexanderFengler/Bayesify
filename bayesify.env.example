# Bayesify environment template.
# Copy to bayesify.env for local use, or add these names to your hosting provider's env settings.

BAYESIFY_LLM_BACKEND=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection. Required for real LLM backends; code provides no model defaults.
BAYESIFY_JUDGE_MODEL=gpt-5.4-nano
BAYESIFY_SCREEN_MODEL=gpt-5.4-nano
BAYESIFY_CLASSIFY_MODEL=gpt-5.4
BAYESIFY_REFUTER_MODEL=gpt-5.4-mini
BAYESIFY_GRADING_STRATEGY=batch

BAYESIFY_MONGODB_URI=
BAYESIFY_MONGODB_DB=bayesify
# MONGODB_URI=
# MONGODB_DATABASE=
# MONGO_DATABASE=
BAYESIFY_MONGODB_SERVER_API=1
BAYESIFY_MONGODB_TIMEOUT_MS=5000
BAYESIFY_MONGODB_AUTOSTART=0
# BAYESIFY_MONGODB_DATA_DIR=

# BAYESIFY_DATA_DIR=
BAYESIFY_NO_CACHE=0
BAYESIFY_MAX_JOBS=256
BAYESIFY_MAX_UPLOAD_MB=50
# BAYESIFY_WEB_DIST=

OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
BAYESIFY_TRUSTED_TOKENS=

BAYESIFY_ASSESS_CONCURRENCY=
BAYESIFY_ASSESS_CONTEXT_CHARS=500000
BAYESIFY_OVERRIDE_REVIEW_TIMEOUT_S=8
BAYESIFY_AGENT_OUTPUT_FORMAT=

# About-us contact form (Resend). Without RESEND_API_KEY the form returns 503 (disabled).
# CONTACT_FROM_EMAIL must be on a Resend-verified domain in production; onboarding@resend.dev
# works for testing but only delivers to the Resend account owner's own address.
RESEND_API_KEY=
CONTACT_TO_EMAIL=fengleralexander@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
