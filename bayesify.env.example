# Bayesify environment template.
# Copy to bayesify.env for local use, or add these names to your hosting provider's env settings.

BAYESIFY_LLM_BACKEND=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection. Required for real LLM backends; code provides no model defaults.
BAYESIFY_JUDGE_MODEL=gpt-5.4-mini
BAYESIFY_SCREEN_MODEL=gpt-5.4-mini
BAYESIFY_CLASSIFY_MODEL=gpt-5.4-mini
BAYESIFY_REFUTER_MODEL=gpt-5.4-mini
BAYESIFY_GRADING_STRATEGY=batch

BAYESIFY_MONGODB_URI=
BAYESIFY_MONGODB_DB=bayesify
# MONGODB_URI=
# MONGODB_DATABASE=
# MONGO_DATABASE=
BAYESIFY_MONGODB_SERVER_API=1
BAYESIFY_MONGODB_TIMEOUT_MS=5000
BAYESIFY_MONGODB_AUTOSTART=0
# BAYESIFY_MONGODB_DATA_DIR=

# BAYESIFY_DATA_DIR=
BAYESIFY_NO_CACHE=0
BAYESIFY_MAX_JOBS=256
BAYESIFY_MAX_UPLOAD_MB=50
# BAYESIFY_WEB_DIST=

OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
BAYESIFY_TRUSTED_TOKENS=

BAYESIFY_ASSESS_CONCURRENCY=
BAYESIFY_AGENT_OUTPUT_FORMAT=
